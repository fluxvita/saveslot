{
  "name": "saveslot-monorepo",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.22.1 <25 || >=26.12.1"
  },
  "scripts": {
    "build": "tsc -b && node scripts/mark-bins.ts",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/*.prop.test.ts'",
    "test:prop": "vitest run --passWithNoTests '.prop.test.ts'",
    "test:prop:soak": "node scripts/soak-props.ts",
    "test:postgres": "node scripts/test-postgres.ts",
    "smoke:install": "node scripts/smoke-install.ts",
    "deps": "depcruise packages --config .dependency-cruiser.cjs",
    "docs:links": "node scripts/check-doc-links.ts",
    "docs:json": "node scripts/check-json-examples.ts",
    "docs:claims": "node scripts/check-claims.ts",
    "dco": "node scripts/check-dco.ts",
    "mr-title": "node scripts/check-mr-title.ts",
    "terms": "node scripts/check-forbidden-terms.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test:unit && pnpm test:prop && pnpm deps && pnpm docs:links && pnpm docs:json && pnpm docs:claims",
    "check:static": "pnpm typecheck && pnpm lint && pnpm deps && pnpm docs:links && pnpm docs:json && pnpm docs:claims",
    "ci:resources": "node scripts/ci-resources.ts",
    "clean": "tsc -b --clean",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@changesets/cli": "3.0.3",
    "@types/node": "24.19.2",
    "dependency-cruiser": "18.7.2",
    "fast-check": "4.10.2",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
