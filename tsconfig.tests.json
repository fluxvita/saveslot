{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "customConditions": ["source"]
  },
  "include": [
    "packages/*/src/**/*.test.ts",
    "packages/*/src/**/*.fixture.ts",
    "scripts/**/*.ts",
    "experiments/**/*.ts",
    "vitest.config.ts"
  ]
}
