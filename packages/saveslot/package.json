{
  "name": "@fluxvita/saveslot",
  "version": "0.1.0-rc.0",
  "description": "The open-source database all your AI tools share.",
  "keywords": [
    "agent-infrastructure",
    "agent-memory",
    "agent-state",
    "ai-agents",
    "mcp",
    "mcp-server",
    "ai-memory",
    "personal-data",
    "database",
    "claude",
    "open-source",
    "personal-ai"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fluxvita/saveslot.git",
    "directory": "packages/saveslot"
  },
  "homepage": "https://github.com/fluxvita/saveslot#readme",
  "bugs": "https://github.com/fluxvita/saveslot/issues",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.fixture.*",
    "!dist/.tsbuildinfo"
  ],
  "engines": {
    "node": ">=24.22.1 <25 || >=26.12.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@fluxvita/saveslot-cli": "workspace:*",
    "@fluxvita/saveslot-daemon": "workspace:*"
  },
  "bin": {
    "saveslot": "./dist/bin.js"
  }
}
