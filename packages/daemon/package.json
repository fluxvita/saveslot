{
  "name": "@fluxvita/saveslot-daemon",
  "version": "0.0.0",
  "description": "Process entry for the saveslot service: backend selection, configuration, background task scheduler.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./wasm-code-gc": {
      "source": "./src/wasm-code-gc.ts",
      "types": "./dist/wasm-code-gc.d.ts",
      "default": "./dist/wasm-code-gc.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.fixture.*",
    "!dist/.tsbuildinfo"
  ],
  "engines": {
    "node": ">=24.22.1 <25 || >=26.12.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@fluxvita/saveslot-server": "workspace:*",
    "@fluxvita/saveslot-service": "workspace:*",
    "@fluxvita/saveslot-store-pglite": "workspace:*",
    "@fluxvita/saveslot-store-postgres": "workspace:*",
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0"
  }
}
