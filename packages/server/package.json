{
  "name": "@fluxvita/saveslot-server",
  "version": "0.1.0-rc.0",
  "description": "HTTP and MCP adapters for saveslot.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fluxvita/saveslot.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/fluxvita/saveslot#readme",
  "bugs": "https://github.com/fluxvita/saveslot/issues",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.fixture.*",
    "!dist/.tsbuildinfo"
  ],
  "engines": {
    "node": ">=24.22.1 <25 || >=26.12.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@fluxvita/saveslot-contract": "workspace:*",
    "@fluxvita/saveslot-service": "workspace:*",
    "@modelcontextprotocol/server": "2.4.0"
  },
  "devDependencies": {
    "fast-check": "4.10.2"
  }
}
