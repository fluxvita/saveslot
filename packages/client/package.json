{
  "name": "@fluxvita/saveslot-client",
  "version": "0.1.0",
  "description": "HTTP client for the saveslot contract.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fluxvita/saveslot.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/fluxvita/saveslot#readme",
  "bugs": "https://github.com/fluxvita/saveslot/issues",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "source": "./src/testing.fixture.ts"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.fixture.*",
    "!dist/.tsbuildinfo"
  ],
  "engines": {
    "node": ">=24.22.1 <25 || >=26.12.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@fluxvita/saveslot-contract": "workspace:*"
  }
}
