{
  "name": "@fluxvita/saveslot-kernel",
  "version": "0.0.0",
  "description": "The saveslot kernel: log, apply, judge, write, read, delete and the operation layer. Defines the storage and anchor store ports.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./anchor-file": {
      "source": "./src/store/anchor-file.ts",
      "types": "./dist/store/anchor-file.d.ts",
      "default": "./dist/store/anchor-file.js"
    },
    "./testing": {
      "source": "./src/testing.fixture.ts"
    },
    "./rsql-testing": {
      "source": "./src/rules/rsql/rsql-testing.fixture.ts"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.fixture.*",
    "!dist/.tsbuildinfo"
  ],
  "engines": {
    "node": ">=24.22.1 <25 || >=26.12.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@fluxvita/saveslot-contract-core": "workspace:*",
    "libpg-query": "18.2.4"
  },
  "devDependencies": {
    "@fluxvita/saveslot-reference": "workspace:*",
    "fast-check": "4.10.2"
  }
}
