{
  "name": "@fluxvita/saveslot-store-postgres",
  "version": "0.2.0-rc.0",
  "description": "PostgreSQL storage backend for the saveslot kernel.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fluxvita/saveslot.git",
    "directory": "packages/store-postgres"
  },
  "homepage": "https://github.com/fluxvita/saveslot#readme",
